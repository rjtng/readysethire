rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Rule 1: For User Data
    // Secures each user's personal documents (profile, history, etc.).
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Rule 2: For Feedback Submissions
    // Allows users to submit feedback without being able to see others' submissions.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Rule 3: Resumes - per-user resume documents
    // Each resume is stored at /resumes/{userId} and only that user may read/write it.
    match /resumes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Optional example: Protect a 'tools' collection so only users who have
    // completed the resume up to 'experience' can access it.
    // This demonstrates checking a field in the user's resume document.
    // Adjust collection names to match your app's protected resources.
    function progressIndex(level) {
      return level == 'none' ? 0
           : level == 'basic' ? 1
           : level == 'academic' ? 2
           : level == 'experience' ? 3
           : level == 'completed' ? 4
           : 0;
    }

    match /tools/{docId} {
      allow read, write: if request.auth != null
        && progressIndex(get(/databases/$(database)/documents/resumes/$(request.auth.uid)).data.progressLevel) >= progressIndex('experience');
    }

    // Add other collection rules below as needed.
  }
}

